  color: var(--ion-color-medium);
  margin: 0 0 20px;
}

// ── Error Banner ────────────────────────────────────────
.error-banner {
  background: #fde8e8;
  color: var(--color-danger);
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 14px;
  margin-bottom: 16px;
  font-weight: 500;
}

// ── Form ────────────────────────────────────────────────
.auth-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.input-group {
  display: flex;
  align-items: center;
  background: var(--ion-color-light);
  border-radius: 12px;
  padding: 0 12px;
  border: 1.5px solid transparent;
  transition: border-color 0.15s ease;

  &:focus-within {
    border-color: var(--color-brand-primary);
  }
}

.input-icon {
  color: var(--ion-color-medium);
  font-size: 18px;
  flex-shrink: 0;
  margin-right: 8px;
}

.auth-input {
  --background: transparent;
  --color: var(--ion-color-dark);
  flex: 1;
  font-size: 15px;
}

.eye-toggle {
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px 0 8px 8px;
  color: var(--ion-color-medium);
  display: flex;
  align-items: center;
  font-size: 18px;
}

.submit-btn {
  --background: var(--color-brand-primary);
  --color: #ffffff;
  --border-radius: 12px;
  --padding-top: 14px;
  --padding-bottom: 14px;
  font-size: 16px;
  font-weight: 700;
  margin-top: 4px;
}

// ── Divider ─────────────────────────────────────────────
.divider {
  display: flex;
  align-items: center;
  gap: 10px;
}

.divider-line {
  flex: 1;
  height: 1px;
  background: var(--ion-color-light-shade);
}

.divider-text {
  font-size: 13px;
  color: var(--ion-color-medium);
}

// ── Google Button ────────────────────────────────────────
.google-btn {
  --color: var(--ion-color-dark);
  --border-color: var(--ion-color-light-shade);
  --border-radius: 12px;
  font-weight: 600;
}

// ── Mode Toggle ──────────────────────────────────────────
.mode-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 16px;
  font-size: 14px;
}

.toggle-link {
  background: none;
  border: none;
  color: var(--color-brand-primary);
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
}

// ── Mode Tabs ────────────────────────────────────────────────
.mode-tabs {
  display: flex;
  gap: 4px;
  background: var(--ion-color-light);
  border-radius: 14px;
  padding: 4px;
  margin-bottom: 20px;
}

.mode-tab {
  flex: 1;
  background: none;
  border: none;
  padding: 8px 4px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  color: var(--ion-color-medium);
