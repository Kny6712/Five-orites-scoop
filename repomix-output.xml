  transition: all 0.15s ease;

  &.active {
    background: #ffffff;
    color: var(--color-brand-primary);
    box-shadow: 0 1px 4px rgba(0,0,0,0.1);
  }

  &.mode-tab-admin.active {
    background: #fff7e6;
    color: #E65100;
  }
}

// ── Admin Notice ─────────────────────────────────────────────
.admin-notice {
  background: #fff7e6;
  border: 1.5px solid #F4A435;
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 13px;
  color: #E65100;
  margin-bottom: 14px;
  line-height: 1.5;
}

// ── Admin Code Input ─────────────────────────────────────────
.admin-code-group {
  border-color: #F4A435 !important;
  &:focus-within { border-color: #E65100 !important; }
}
.admin-icon { color: #E65100 !important; }

// ── Admin Submit Button ───────────────────────────────────────
.submit-btn-admin {
  --background: #E65100 !important;
}
