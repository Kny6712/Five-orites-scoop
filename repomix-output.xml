  height: 60px;
  border-radius: 10px;
  background: var(--color-brand-light);
  flex-shrink: 0;
  overflow: hidden;
}
.item-image { width: 100%; height: 100%; object-fit: cover; }

.item-info { flex: 1; min-width: 0; }
.item-name { font-size: 14px; font-weight: 700; color: var(--ion-color-dark); margin: 0 0 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.item-meta { font-size: 12px; color: var(--ion-color-medium); margin: 0 0 2px; }
.item-unit-price { font-size: 12px; color: var(--ion-color-medium); margin: 0; }

.item-controls { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }

.qty-stepper { display: flex; align-items: center; gap: 10px; background: var(--ion-color-light); border-radius: 10px; padding: 4px 8px; }
.qty-btn {
  background: none; border: none; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
  cursor: pointer; border-radius: 6px; color: var(--color-brand-primary); font-size: 18px;
  &:disabled { color: var(--ion-color-light-shade); }
}
.qty-num { font-size: 15px; font-weight: 700; min-width: 20px; text-align: center; }

.item-subtotal { font-size: 15px; font-weight: 700; color: var(--color-brand-primary); margin: 0; }
.remove-btn { background: none; border: none; color: var(--color-danger); cursor: pointer; font-size: 18px; padding: 4px; }

// ── Order Summary ────────────────────────────────────────
.order-summary {
  margin: 4px 16px 0;
  padding: 16px;
  background: var(--color-brand-light);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.summary-row { display: flex; justify-content: space-between; font-size: 14px; color: var(--ion-color-dark); }
.total-row { border-top: 1px solid rgba(107,63,160,0.15); padding-top: 8px; margin-top: 4px; }
.total-amount { font-size: 20px; font-weight: 800; color: var(--color-brand-primary); }

// ── Checkout Form ────────────────────────────────────────
.checkout-form { padding: 16px 16px 40px; }
.form-title { font-size: 18px; font-weight: 700; margin: 16px 0 12px; }

.error-banner { background: #fde8e8; color: var(--color-danger); border-radius: 10px; padding: 10px 14px; font-size: 14px; margin-bottom: 12px; font-weight: 500; }

.input-wrap { margin-bottom: 14px; }
.field-label { font-size: 13px; font-weight: 600; color: var(--ion-color-dark); display: block; margin-bottom: 6px; }
.field-input { --background: var(--ion-color-light); --border-radius: 12px; --padding-start: 14px; --padding-end: 14px; }

.checkout-btn { --background: var(--color-brand-primary); --border-radius: 12px; --padding-top: 14px; --padding-bottom: 14px; font-weight: 700; font-size: 16px; margin-top: 8px; }
.clear-btn { margin-top: 4px; font-size: 14px; }

// ── Review ────────────────────────────────────────────────
.review-container { padding: 20px 16px 40px; }
.review-section-title { font-size: 18px; font-weight: 700; margin: 0 0 12px; }

.review-item { display: flex; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--ion-color-light-shade); font-size: 14px; }
.review-item-name { flex: 1; color: var(--ion-color-dark); }
.review-item-qty { color: var(--ion-color-medium); }
.review-item-price { font-weight: 700; color: var(--color-brand-primary); }

.review-address-box { background: var(--color-brand-light); border-radius: 12px; padding: 14px; margin: 16px 0; }
.review-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-brand-primary); margin: 0 0 4px; }
.review-value { font-size: 14px; color: var(--ion-color-dark); margin: 0; }
.review-notes { font-size: 13px; color: var(--ion-color-medium); margin: 4px 0 0; font-style: italic; }

.place-order-btn { --background: var(--color-brand-accent); --color: #fff; --border-radius: 12px; --padding-top: 14px; --padding-bottom: 14px; font-weight: 700; font-size: 16px; margin-top: 16px; }
.back-btn { --border-radius: 12px; margin-top: 8px; }

// ── Confirmed ────────────────────────────────────────────
.confirmed-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; gap: 14px; text-align: center; padding: 20px; }
.confirmed-icon { font-size: 80px; color: var(--color-success); }
.confirmed-title { font-size: 28px; font-weight: 800; margin: 0; color: var(--ion-color-dark); }
.confirmed-sub { font-size: 15px; color: var(--ion-color-medium); margin: 0; max-width: 280px; }
</file>

