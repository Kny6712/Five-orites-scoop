// Five-orites Scoop — App Shell Styles

:host {
  display: block;
}

// ── Menu Header / Branding ─────────────────────────────
.menu-header {
  background: linear-gradient(160deg, var(--color-brand-primary) 0%, #8b56c4 100%);
  padding: 40px 20px 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.menu-logo-wrap {
  width: 72px;
  height: 72px;
  border-radius: 20px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.menu-logo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.menu-brand {
  color: #ffffff;
  font-size: 18px;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.3px;
}

.menu-tagline {
  color: rgba(255, 255, 255, 0.7);
  font-size: 12px;
  margin: 0;
  font-weight: 400;
}

// ── Nav List ───────────────────────────────────────────
.menu-content {
  --background: #ffffff;
  display: flex;
  flex-direction: column;
}

.nav-list {
  padding: 12px 8px;

  &.admin-nav {
    border-top: 1px solid var(--ion-color-light-shade);
    margin-top: 8px;
  }
}

.nav-section-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--ion-color-medium);
  letter-spacing: 0.8px;
  text-transform: uppercase;
  padding-left: 16px;
  padding-bottom: 4px;

  &.admin-label {
    color: var(--color-brand-primary);
  }
}

.nav-item {
  --border-radius: 12px;
  --padding-start: 14px;
  --padding-end: 14px;
  --min-height: 48px;
  --color: var(--ion-color-dark);
  /* Ring colour for .cart-badge — swapped on the active row so the bubble keeps
     a clean edge against the tinted background instead of showing a white halo. */
  --cart-badge-ring: var(--ion-item-background, var(--ion-background-color, #fff));
  border-radius: 12px;
  margin-bottom: 2px;
  transition: background 0.15s ease;

  &.active-nav-item {
    --background: var(--color-brand-light);
    --color: var(--color-brand-primary);
    --cart-badge-ring: var(--color-brand-light);
    font-weight: 600;

    .nav-icon {
      color: var(--color-brand-primary);
    }
  }
}

/* Positioning context for the count bubble. The wrapper rather than the ion-icon
   itself because the bubble has to be able to hang outside the glyph box, and
   ion-icon is sized 1em — a box exactly the size of the glyph, leaving nothing
   to overhang into.

   ion-item's ::slotted([slot=start]) rules (margin-inline-end: 32px) still apply
   to this element, so the gap between icon and label is unchanged. The rules
   that targeted a bare ::slotted(ion-icon) no longer match — 12px block margins
   and 1.5em — but at 20px in a 48px row neither was doing any work: the row's
   min-height already wins, and .nav-icon restates the font size. */
.nav-icon-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-icon {
  font-size: 20px;
  color: var(--ion-color-medium);
  transition: color 0.15s ease;
}

.admin-nav-icon {
  color: var(--color-brand-primary);
  opacity: 0.7;
}

/* A plain span, deliberately not <ion-badge> — same reasoning as the toolbar
   cart button: ion-badge's :host pins its own display/font-size/padding and
   carries contain:content, so a bubble that has to overlap a glyph is far
   easier to control with a span.

   Offsets are relative to the 20px icon box and put the bubble's own centre
   almost exactly on the cart's top-right corner, with a couple of pixels of
   overhang so it reads as *on* the icon rather than tucked beside it. Both
   values stay inside ion-item's overflow:hidden — the row is 48px tall and
   vertically centres the icon, which leaves ~14px of headroom above it. */
.cart-badge {
  position: absolute;
  top: -7px;
  right: -6px;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  /* ion-item applies letter-spacing: 0.033em to slotted content. That trailing
     track lands after the glyph, so the flex-centred text sits a couple of
     pixels left of the bubble's true middle — zeroing it is what centres it. */
  letter-spacing: 0;
  color: var(--ion-color-danger-contrast, #fff);
  background: var(--ion-color-danger, #c62828);
  border-radius: 999px;
  /* Ring in the row's own background so the bubble reads as sitting on top of
     the cart stroke instead of merging into it. */
  box-shadow: 0 0 0 2px var(--cart-badge-ring);
  /* Decoration on top of the row — the whole item stays one tap target. */
  pointer-events: none;
}

// ── Spacer ─────────────────────────────────────────────
.menu-spacer {
  flex: 1;
  min-height: 20px;
}

// ── User Panel ─────────────────────────────────────────
.user-panel {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px;
  border-top: 1px solid var(--ion-color-light-shade);
