// src/theme/variables.scss
// Five-orites Scoop — Global CSS Variables & Design Tokens
// Author: [Developer Placeholder]

:root {
  // ── Brand Tokens ──────────────────────────────────────────
  --color-brand-primary: #6B3FA0;       // Deep purple — primary brand
  --color-brand-accent: #F4A435;        // Warm amber — highlights, CTAs
  --color-brand-light: #F9EFF7;         // Pale lavender — backgrounds
  --color-success: #2E7D32;
  --color-warning: #E65100;
  --color-danger: #C62828;
  --color-stock-ok: var(--color-success);
  --color-stock-low: var(--color-warning);
  --color-stock-out: var(--color-danger);

  // ── Ionic Ion Color Overrides ─────────────────────────────
  --ion-color-primary: #6B3FA0;
  --ion-color-primary-rgb: 107, 63, 160;
  --ion-color-primary-contrast: #ffffff;
  --ion-color-primary-contrast-rgb: 255, 255, 255;
  --ion-color-primary-shade: #5e378d;
  --ion-color-primary-tint: #7a52aa;

  --ion-color-secondary: #F4A435;
  --ion-color-secondary-rgb: 244, 164, 53;
  --ion-color-secondary-contrast: #ffffff;
  --ion-color-secondary-contrast-rgb: 255, 255, 255;
  --ion-color-secondary-shade: #d7912e;
  --ion-color-secondary-tint: #f5ad49;

  --ion-color-success: #2E7D32;
  --ion-color-success-rgb: 46, 125, 50;
  --ion-color-success-contrast: #ffffff;
  --ion-color-success-shade: #286e2c;
  --ion-color-success-tint: #438a47;

  --ion-color-warning: #E65100;
  --ion-color-warning-rgb: 230, 81, 0;
  --ion-color-warning-contrast: #ffffff;
  --ion-color-warning-shade: #ca4700;
  --ion-color-warning-tint: #e9621a;

  --ion-color-danger: #C62828;
  --ion-color-danger-rgb: 198, 40, 40;
  --ion-color-danger-contrast: #ffffff;
  --ion-color-danger-shade: #ae2323;
  --ion-color-danger-tint: #cc3e3e;

  // Tertiary — used by the "Out for Delivery" status badge and the team role
  // chips on the Developers page. It was referenced but never defined, so those
  // elements rendered with no colour at all.
  --ion-color-tertiary: #00897B;
  --ion-color-tertiary-rgb: 0, 137, 123;
  --ion-color-tertiary-contrast: #ffffff;
  --ion-color-tertiary-contrast-rgb: 255, 255, 255;
  --ion-color-tertiary-shade: #00796c;
  --ion-color-tertiary-tint: #1a9385;

  // ── Neutral Palette ──────────────────────────────────────────
  // Referenced ~137 times across the app but never defined. Ionic only carries
  // these as fallbacks inside its own component CSS, never on :root, so every
  // bare var(--ion-color-light) here resolved to nothing. Because background
  // and border-* are not inherited properties, an invalid var() makes them fall
  // back to `transparent` / drop the declaration entirely — which is why grey
  // panels rendered invisible and hairline dividers never appeared. (color is
  // inherited, so the text usages happened to look fine and hid the problem.)
  // Values are Ionic 7's own defaults.
  --ion-color-light: #f4f5f8;
  --ion-color-medium: #989aa2;
  --ion-color-dark: #222428;
  --ion-color-light-shade: #d7d8da;
  --ion-color-dark-shade: #1e2023;

  --ion-font-family: -apple-system, 'Helvetica Neue', sans-serif;
  --ion-background-color: #f8f8f8;
  --ion-toolbar-background: var(--color-brand-primary);
  --ion-toolbar-color: #ffffff;
}

// ── Typography Scale ─────────────────────────────────────────
h1 { font-size: 28px; font-weight: 700; }
h2 { font-size: 22px; font-weight: 600; }
h3 { font-size: 18px; font-weight: 600; }

// ── Global Component Defaults ─────────────────────────────────
ion-card {
  border-radius: 16px !important;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08) !important;
}

ion-button {
  --border-radius: 12px;
  font-weight: 600;
}

ion-toolbar {
  --background: var(--color-brand-primary);
  --color: #ffffff;
}

ion-menu-button {
  --color: #ffffff;
}

ion-back-button {
  --color: #ffffff;
}

/* A bare <ion-button> (no `fill`) picks up Ionic's `.button-clear` treatment,
   which sets `--color: var(--ion-color-primary)`. Because this app overrides
   `--ion-color-primary` with the brand purple, that resolves to the exact same
   value a `color="primary"` toolbar uses for its background — so the button
   paints purple on purple. It still occupies its box and stays clickable, which
   is what makes it so confusing: an invisible button rather than a missing one.

   `ion-title` never hit this because it takes the toolbar's contrast colour
   rather than the base colour, which is why the page title rendered fine while
   the button next to it did not. Toolbar buttons need the contrast colour
   spelled out, same as ion-menu-button and ion-back-button above. */
ion-toolbar ion-button {
  --color: var(--ion-color-primary-contrast, #ffffff);
}
