    @if (!imageLoaded()) {
      <ion-skeleton-text animated class="image-skeleton"></ion-skeleton-text>
    }
    <img
      [src]="(product.imageUrl | cloudinary: 400) || 'assets/placeholder-scoop.svg'"
      [alt]="product.variantName"
      class="card-image"
      [class.image-visible]="imageLoaded()"
      (load)="onImageLoad()"
      (error)="onImageError($event)"
    />
    <div class="set-badge">Set {{ product.setNumber }} · {{ product.setName }}</div>
    <button class="wishlist-btn" (click)="toggleWishlist($event)" [attr.aria-label]="isWished() ? 'Remove from wishlist' : 'Save to wishlist'">
      <ion-icon [name]="isWished() ? 'heart' : 'heart-outline'" [color]="isWished() ? 'danger' : 'medium'"></ion-icon>
    </button>
  </div>

  <ion-card-content class="card-body" (click)="$event.stopPropagation()">

    <h3 class="variety-name">{{ product.variantName }}</h3>

    <ion-segment
      [value]="selectedSize()"
      (ionChange)="onSizeChange($event)"
      class="size-segment"
      mode="md"
    >
      @for (size of sizes; track size) {
        <ion-segment-button [value]="size" class="size-btn">
          <ion-label>{{ sizeLabels[size] }}</ion-label>
        </ion-segment-button>
      }
    </ion-segment>

    <div class="price-stock-row">
      <span class="price">{{ currentPrice() | peso }}</span>
      <ion-chip
        [color]="currentStock() === 0 ? 'danger' : currentStock() < lowStockThreshold ? 'warning' : 'success'"
        class="stock-chip"
      >
        <ion-label>
          {{ currentStock() === 0 ? 'Out of Stock' : currentStock() < lowStockThreshold ? 'Low Stock' : 'In Stock' }}
        </ion-label>
      </ion-chip>
    </div>

    <ion-button
      expand="block"
      class="add-to-cart-btn"
      [disabled]="isOutOfStock() || isAdding()"
      (click)="addToCart()"
    >
      <ion-icon name="cart-outline" slot="start"></ion-icon>
      {{ isAdding() ? 'Adding...' : isOutOfStock() ? 'Out of Stock' : 'Add to Cart' }}
    </ion-button>

  </ion-card-content>
</ion-card>
