<!-- Five-orites Scoop — Split-Pane Shell + Side Menu -->

<ion-app>
  <ion-split-pane contentId="main-content" when="md">

    <!-- ═══════════════════════════════════════════
         SIDE NAVIGATION MENU
    ═══════════════════════════════════════════ -->
    <ion-menu contentId="main-content" type="overlay" class="app-menu">

      <!-- Menu Header / Branding -->
      <div class="menu-header">
        <div class="menu-logo-wrap">
          <img src="assets/placeholder-scoop.svg" alt="Five-orites Scoop logo — colorful ice cream bowl with three scoops" class="menu-logo" />
        </div>
        <h1 class="menu-brand">Five-orites Scoop</h1>
        <p class="menu-tagline">Premium ice cream, scooped to your door</p>
      </div>

      <ion-content class="menu-content ion-padding-bottom">

        <!-- Customer / Shared Navigation -->
        <ion-list lines="none" class="nav-list">
          <ion-list-header class="nav-section-label">Menu</ion-list-header>

          @for (item of visibleCustomerNavItems(); track item.url) {
            <ion-menu-toggle auto-hide="false">
              <ion-item
                [routerLink]="item.url"
                routerLinkActive="active-nav-item"
                [routerLinkActiveOptions]="{ exact: item.url === '/dashboard' }"
                detail="false"
                class="nav-item"
                [attr.aria-label]="navItemLabel(item)"
              >
                <!-- The icon is wrapped so the count has something local to
                     anchor to. Slotting the count itself would put it at the far
                     end of the row, detached from the cart it belongs to, and
                     positioning it against the item instead would mean hard-coding
                     the icon's offset from --padding-start and the row height. -->
                <span slot="start" class="nav-icon-wrap">
                  <ion-icon [name]="item.icon" class="nav-icon"></ion-icon>
                  @if (item.badge && cartItemCount() > 0) {
                    <span class="cart-badge" aria-hidden="true">{{ cartItemCount() }}</span>
                  }
                </span>
                <ion-label>{{ item.title }}</ion-label>
              </ion-item>
            </ion-menu-toggle>
          }
        </ion-list>

        <!-- Admin Section — Only visible to admins -->
        @if (isAdmin()) {
          <ion-list lines="none" class="nav-list admin-nav">
            <ion-list-header class="nav-section-label admin-label">Admin Panel</ion-list-header>

            @for (item of adminNavItems; track item.url) {
              <ion-menu-toggle auto-hide="false">
                <ion-item
                  [routerLink]="item.url"
                  routerLinkActive="active-nav-item"
                  detail="false"
                  class="nav-item"
                  [attr.aria-label]="item.title"
                >
                  <ion-icon [name]="item.icon" slot="start" class="nav-icon admin-nav-icon"></ion-icon>
                  <ion-label>{{ item.title }}</ion-label>
                </ion-item>
              </ion-menu-toggle>
            }
          </ion-list>
        }

        <!-- Spacer to push user panel to bottom -->
        <div class="menu-spacer"></div>

        <!-- User Profile Panel -->
        @if (currentUser()) {
          <div class="user-panel">
            <div class="user-info">
              <ion-avatar class="user-avatar">
                @if (currentUser()?.photoURL) {
                  <img [src]="currentUser()!.photoURL" [alt]="'Profile photo of ' + currentUser()!.displayName" />
                } @else {
                  <div class="avatar-initials">{{ getUserInitials() }}</div>
                }
              </ion-avatar>
