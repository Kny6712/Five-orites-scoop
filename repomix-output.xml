<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>Sales Analytics</ion-title>
    <ion-buttons slot="end">
      <app-cart-button></app-cart-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>
  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>

  @if (isLoading()) {
    <div class="analytics-body">
      @for (s of [1,2,3,4]; track s) {
        <ion-card><ion-skeleton-text animated style="height:80px;"></ion-skeleton-text></ion-card>
      }
    </div>
  }

  @if (!isLoading()) {
    <div class="analytics-body">

      <ion-segment [value]="dateRange()" (ionChange)="setDateRange($any($event).detail.value)">
        <ion-segment-button value="all"><ion-label>All</ion-label></ion-segment-button>
        <ion-segment-button value="today"><ion-label>Today</ion-label></ion-segment-button>
        <ion-segment-button value="7d"><ion-label>7d</ion-label></ion-segment-button>
        <ion-segment-button value="30d"><ion-label>30d</ion-label></ion-segment-button>
      </ion-segment>
      <ion-button expand="block" fill="outline" (click)="exportCsv()">Export CSV</ion-button>

      <div class="kpi-grid">
        <div class="kpi-tile kpi-revenue">
          <ion-icon name="cash-outline" class="kpi-icon"></ion-icon>
          <p class="kpi-label">Revenue (Delivered)</p>
          <p class="kpi-val">{{ totalRevenue() | peso }}</p>
        </div>
        <div class="kpi-tile kpi-orders">
          <ion-icon name="receipt-outline" class="kpi-icon"></ion-icon>
          <p class="kpi-label">Total Orders</p>
          <p class="kpi-val">{{ totalOrders() }}</p>
        </div>
        <div class="kpi-tile kpi-delivered">
          <ion-icon name="trending-up-outline" class="kpi-icon"></ion-icon>
          <p class="kpi-label">Delivered</p>
          <p class="kpi-val">{{ deliveredOrders() }}</p>
        </div>
        <div class="kpi-tile kpi-avg">
          <ion-icon name="ice-cream-outline" class="kpi-icon"></ion-icon>
          <p class="kpi-label">Avg. Delivered Order</p>
          <p class="kpi-val">{{ avgOrderValue() | peso }}</p>
        </div>
      </div>

      <!-- Say so out loud rather than quietly filtering: if the admin ever
           wonders why revenue looks lower than Fulfillment's order count, the
           answer is here instead of being a mystery. -->
      @if (myOrderCount() > 0) {
        <p class="analytics-note">
          Excludes your {{ myOrderCount() }} own order{{ myOrderCount() === 1 ? '' : 's' }} —
          an owner purchase isn't revenue. They still appear in Fulfillment.
        </p>
      }

      <h3 class="section-title">Top Flavors by Units Sold (Delivered)</h3>
      @if (topFlavors().length === 0) {
        <p class="no-data">No sales data yet.</p>
      }
      @for (flavor of topFlavors(); track flavor.name; let i = $index) {
        <div class="flavor-row">
          <span class="flavor-rank">#{{ i + 1 }}</span>
          <div class="flavor-info">
            <span class="flavor-name">{{ flavor.name }}</span>
            <div class="flavor-bar-wrap">
              <div
                class="flavor-bar"
                [style.width.%]="topFlavors()[0].count > 0 ? (flavor.count / topFlavors()[0].count) * 100 : 0"
              ></div>
            </div>
          </div>
          <div class="flavor-stats">
            <span class="flavor-units">{{ flavor.count }} units</span>
            <span class="flavor-revenue">{{ flavor.revenue | peso }}</span>
          </div>
        </div>
      }

      <h3 class="section-title">Sales by Flavor Set (Delivered)</h3>
      @for (s of salesBySet(); track s.name) {
        <div class="flavor-row">
          <div class="flavor-info"><span class="flavor-name">{{ s.name }}</span></div>
          <div class="flavor-stats">
            <span class="flavor-units">{{ s.count }} units</span>
            <span class="flavor-revenue">{{ s.revenue | peso }}</span>
          </div>
        </div>
      }

      <h3 class="section-title">Sales by Size (Delivered)</h3>
      @for (s of salesBySize(); track s.name) {
        <div class="flavor-row">
          <div class="flavor-info"><span class="flavor-name">{{ s.name }}</span></div>
          <div class="flavor-stats">
            <span class="flavor-units">{{ s.count }} units</span>
            <span class="flavor-revenue">{{ s.revenue | peso }}</span>
          </div>
        </div>
      }

    </div>
  }
</ion-content>
