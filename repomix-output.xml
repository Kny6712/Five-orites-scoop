    <div class="detail-body">
      <ion-skeleton-text animated style="height: 24px; width: 70%; margin-bottom: 8px;"></ion-skeleton-text>
      <ion-skeleton-text animated style="height: 140px;"></ion-skeleton-text>
    </div>
  }

  @if (!isLoading() && errorMessage()) {
    <div class="error-state"><p>{{ errorMessage() }}</p></div>
  }

  @if (!isLoading() && product()) {
    <div class="hero-wrap">
      <img
        [src]="product()!.imageUrl || 'assets/placeholder-scoop.svg'"
        [alt]="product()!.variantName"
        class="hero-image"
        onerror="this.src='assets/placeholder-scoop.svg'"
      />
      <div class="hero-overlay">
        <ion-badge class="set-badge-hero">
          Set {{ product()!.setNumber }} · {{ product()!.setName }}
        </ion-badge>
      </div>
    </div>

    <div class="detail-body">
      <h1 class="detail-name">{{ product()!.variantName }}</h1>
      <app-star-rating [rating]="avgRating()" [showCount]="true" [reviewCount]="reviewCount()"></app-star-rating>
      <ion-button fill="outline" size="small" (click)="toggleWishlist()">
        <ion-icon [name]="isWished() ? 'heart' : 'heart-outline'" slot="start"></ion-icon>
        {{ isWished() ? 'Wishlisted' : 'Wishlist' }}
      </ion-button>
      <p class="detail-description">{{ product()!.description }}</p>

      <h2 class="section-title">Choose Your Size</h2>
      <div class="size-grid">
        @for (opt of sizeOptions; track opt.key) {
          <button
            class="size-tile"
            [class.selected]="selectedSize() === opt.key"
            [class.out-of-stock]="product()!.stock[opt.key] === 0"
            (click)="selectSize(opt.key)"
            [attr.aria-pressed]="selectedSize() === opt.key"
          >
            <span class="tile-size">{{ opt.label }}</span>
            <span class="tile-price">{{ product()!.pricing[opt.key] | peso }}</span>
            <span class="tile-stock"
              [class.stock-in-stock]="product()!.stock[opt.key] >= 10"
              [class.stock-low-stock]="product()!.stock[opt.key] > 0 && product()!.stock[opt.key] < 10"
              [class.stock-out-of-stock]="product()!.stock[opt.key] === 0">
              {{ product()!.stock[opt.key] === 0 ? 'Out of Stock' :
                 product()!.stock[opt.key] < 10 ? 'Low Stock (' + product()!.stock[opt.key] + ')' : 'In Stock' }}
            </span>
          </button>
        }
      </div>

      <div class="qty-row">
        <span class="qty-label">Quantity</span>
        <div class="qty-controls">
          <button class="qty-btn" (click)="decrementQty()" [disabled]="quantity() <= 1">
            <ion-icon name="remove-outline"></ion-icon>
          </button>
          <span class="qty-value">{{ quantity() }}</span>
          <button class="qty-btn" (click)="incrementQty()" [disabled]="quantity() >= currentStock()">
            <ion-icon name="add-outline"></ion-icon>
          </button>
        </div>
        <span class="line-total">{{ lineTotal() | peso }}</span>
      </div>

      <ion-button
        expand="block"
        class="add-to-cart-cta"
        [disabled]="isOutOfStock() || isAdding()"
        (click)="addToCart()"
      >
        <ion-icon name="cart-outline" slot="start"></ion-icon>
        {{ isAdding() ? 'Adding...' : isOutOfStock() ? 'Out of Stock' : 'Add to Cart' }}
      </ion-button>

      <div class="reviews-section">
        <h2 class="section-title">Customer Reviews</h2>
        @if (reviews().length === 0) {
          <div class="reviews-empty">
            <app-star-rating [rating]="0" [showCount]="true" [reviewCount]="0"></app-star-rating>
            <p class="no-reviews">No reviews yet — be the first!</p>
          </div>
        } @else {
          @for (r of reviews(); track r.id) {
            <div class="review-item">
              <app-star-rating [rating]="r.rating"></app-star-rating>
              <p class="review-author">{{ r.displayName }}</p>
              <p class="review-comment">{{ r.comment }}</p>
            </div>
          }
        }
        <div class="review-form">
          <h3 class="section-title">Write a review</h3>
          <app-star-rating [rating]="newRating()" [interactive]="true" (ratingChange)="newRating.set($event)"></app-star-rating>
          <ion-textarea [(ngModel)]="newComment" placeholder="What did you love?" rows="2"></ion-textarea>
          <ion-button expand="block" (click)="submitReview()" [disabled]="isSubmittingReview()">
            {{ isSubmittingReview() ? 'Submitting...' : 'Submit Review' }}
          </ion-button>
        </div>
      </div>
    </div>
  }

</ion-content>
</file>

