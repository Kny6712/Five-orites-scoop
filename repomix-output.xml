<file path="src/app/features/orders/order-tracker/order-tracker.page.html">
<!-- src/app/features/orders/order-tracker/order-tracker.page.html -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-back-button defaultHref="/orders" text="Orders"></ion-back-button>
    </ion-buttons>
    <ion-title>Order Tracker</ion-title>
    <ion-buttons slot="end">
      <app-cart-button></app-cart-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>

  <!-- Loading -->
  @if (isLoading()) {
    <div class="tracker-body">
      <ion-skeleton-text animated style="height:20px; width:50%; margin-bottom:8px;"></ion-skeleton-text>
      <ion-skeleton-text animated style="height:160px; border-radius:14px;"></ion-skeleton-text>
    </div>
  }

  <!-- Error -->
  @if (!isLoading() && errorMessage()) {
    <div class="error-state">
      <p>{{ errorMessage() }}</p>
    </div>
  }

  <!-- Tracker Content -->
  @if (!isLoading() && order()) {
    <div class="tracker-body">

      <!-- Order ID + Date -->
      <div class="order-header">
        <div>
          <p class="order-label">Order</p>
          <h2 class="order-id">#{{ order()!.id.slice(-6).toUpperCase() }}</h2>
        </div>
        <div class="order-date-wrap">
          <p class="order-label">Placed</p>
          <p class="order-date">{{ formatDate(order()!.createdAt) }}</p>
        </div>
        <app-order-status-badge [status]="order()!.status"></app-order-status-badge>
      </div>

      <!-- Cancelled Banner -->
      @if (isCancelled()) {
        <div class="cancelled-banner">
          <ion-icon name="close-circle-outline"></ion-icon>
          This order has been cancelled.
          @if (order()!.cancelReason) {
            <p class="info-notes">Reason: {{ order()!.cancelReason }}</p>
          }
        </div>
      }

      @if (canCancel()) {
        <ion-button expand="block" fill="outline" color="danger" (click)="cancelOrder()" [disabled]="isCancelling()">
          {{ isCancelling() ? 'Cancelling...' : 'Cancel Order' }}
        </ion-button>
      }

      <!-- Status Timeline (vertical stepper) -->
      @if (!isCancelled()) {
        <div class="timeline">
          @for (step of statusSequence; track step) {
            <div class="timeline-step" [class]="'step-' + getStepState(step)">
              <div class="step-icon-wrap">
                <div class="step-dot">
                  <ion-icon [name]="statusMeta[step].icon" class="step-icon"></ion-icon>
                </div>
                @if (!$last) {
                  <div class="step-line"></div>
                }
              </div>
              <div class="step-content">
                <p class="step-label">{{ statusMeta[step].label }}</p>
                @if (getStepState(step) === 'active') {
                  <p class="step-desc">{{ statusMeta[step].description }}</p>
                }
                @if (getStepTimestamp(step)) {
                  <p class="step-time">{{ getStepTimestamp(step) }}</p>
                }
              </div>
            </div>
          }
        </div>
      }

      <!-- Delivery Address -->
      <ion-card class="info-card">
        <ion-card-content>
          <p class="info-label">Delivering to</p>
          <p class="info-value">{{ order()!.deliveryAddress }}</p>
          @if (order()!.notes) {
            <p class="info-notes">Note: {{ order()!.notes }}</p>
          }
        </ion-card-content>
      </ion-card>

      <!-- Order Items -->
      <ion-card class="info-card">
        <ion-card-content>
          <p class="info-label">Items Ordered</p>
          @for (item of order()!.items; track item.productId + item.size) {
            <div class="order-item-row">
              <span class="item-name">{{ item.variantName }}</span>
              <span class="item-size">{{ sizeLabels[item.size] }}</span>
              <span class="item-qty">×{{ item.quantity }}</span>
              <span class="item-price">{{ item.subtotal | peso }}</span>
            </div>
          }
          <div class="totals-block">
            <div class="total-row">
              <span>Subtotal</span>
              <span>{{ order()!.totalAmount | peso }}</span>
            </div>
            @if ((order()!.discountAmount ?? 0) > 0) {
              <div class="total-row">
                <span>Voucher {{ order()!.voucherCode }}</span>
                <span>-{{ (order()!.discountAmount ?? 0) | peso }}</span>
              </div>
            }
            <div class="total-row">
              <span>Delivery</span>
              <span>{{ order()!.deliveryFee === 0 ? 'FREE' : (order()!.deliveryFee | peso) }}</span>
            </div>
            <div class="total-row grand">
              <span>Total</span>
              <span>{{ order()!.grandTotal | peso }}</span>
            </div>
          </div>
        </ion-card-content>
      </ion-card>

    </div>
  }

</ion-content>
</file>

<file path="src/app/features/orders/orders.page.html">
<!-- src/app/features/orders/orders.page.html -->
<!-- Five-orites Scoop — Order History -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>My Orders</ion-title>
    <ion-buttons slot="end">
      <app-cart-button></app-cart-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>

  <ion-refresher slot="fixed" (ionRefresh)="handleRefresh($event)">
    <ion-refresher-content></ion-refresher-content>
  </ion-refresher>

  <!-- Loading Skeleton -->
  @if (isLoading()) {
    <ion-list>
      @for (s of skeletonItems; track $index) {
        <ion-item class="order-skeleton-item">
          <div class="skeleton-wrap">
            <ion-skeleton-text animated style="height:16px; width:60%; margin-bottom:6px;"></ion-skeleton-text>
            <ion-skeleton-text animated style="height:12px; width:40%;"></ion-skeleton-text>
          </div>
          <div slot="end">
            <ion-skeleton-text animated style="height:24px; width:80px;"></ion-skeleton-text>
          </div>
        </ion-item>
      }
    </ion-list>
  }

  <!-- Error -->
  @if (!isLoading() && errorMessage()) {
    <div class="empty-state">
      <ion-icon name="sad-outline" class="empty-icon"></ion-icon>
      <p class="empty-title">Something went wrong</p>
      <p class="empty-sub">{{ errorMessage() }}</p>
    </div>
  }

  <!-- Empty -->
  @if (!isLoading() && !errorMessage() && orders().length === 0) {
    <div class="empty-state">
      <ion-icon name="receipt-outline" class="empty-icon"></ion-icon>
      <p class="empty-title">No orders yet</p>
      <p class="empty-sub">When you place an order, it'll show up here.</p>
    </div>
  }

  <!-- Orders List -->
  @if (!isLoading() && orders().length > 0) {
    <ion-list class="orders-list">
      @for (order of orders(); track trackOrder($index, order)) {
        <ion-item
          [routerLink]="['/orders', order.id]"
          detail="true"
          class="order-item"
          button
        >
          <div class="order-info">
            <div class="order-top-row">
              <span class="order-id">Order #{{ order.id.slice(-6).toUpperCase() }}</span>
              <app-order-status-badge [status]="order.status"></app-order-status-badge>
            </div>
            <p class="order-meta">
              {{ order.items.length }} item{{ order.items.length !== 1 ? 's' : '' }}
              · {{ order.grandTotal | peso }}
              @if (order.voucherCode) { · {{ order.voucherCode }} }
            </p>
            <p class="order-date">{{ formatDate(order.createdAt) }}</p>
            @if (canCancel(order)) {
              <ion-button
                fill="outline"
                color="danger"
                size="small"
                (click)="cancelOrder(order, $event)"
                [disabled]="cancellingId() === order.id"
              >
                {{ cancellingId() === order.id ? 'Cancelling...' : 'Cancel Order' }}
              </ion-button>
            }
          </div>
        </ion-item>
      }
    </ion-list>
  }

</ion-content>
</file>

<file path="src/app/features/products/product-detail/product-detail.page.html">
<!-- src/app/features/products/product-detail/product-detail.page.html -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-back-button defaultHref="/products" text="Flavors"></ion-back-button>
    </ion-buttons>
    <ion-title>{{ product()?.variantName ?? 'Product Detail' }}</ion-title>
    <ion-buttons slot="end">
      <app-cart-button></app-cart-button>
    </ion-buttons>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>

  @if (isLoading()) {
    <ion-skeleton-text animated class="hero-skeleton"></ion-skeleton-text>
    <div class="detail-body">
      <ion-skeleton-text animated style="height: 24px; width: 70%; margin-bottom: 8px;"></ion-skeleton-text>
      <ion-skeleton-text animated style="height: 140px;"></ion-skeleton-text>
    </div>
  }

  @if (!isLoading() && errorMessage()) {
    <div class="error-state"><p>{{ errorMessage() }}</p></div>
  }

  @if (!isLoading() && product()) {
    <div class="hero-wrap">
      <img
        [src]="(product()!.imageUrl | cloudinary: 1000) || 'assets/placeholder-scoop.svg'"
        [alt]="product()!.variantName"
        class="hero-image"
        onerror="this.src='assets/placeholder-scoop.svg'"
      />
      <div class="hero-overlay">
        <ion-badge class="set-badge-hero">
          Set {{ product()!.setNumber }} · {{ product()!.setName }}
        </ion-badge>
      </div>
    </div>

    <div class="detail-body">
      <h1 class="detail-name">{{ product()!.variantName }}</h1>
      <app-star-rating [rating]="avgRating()" [showCount]="true" [reviewCount]="reviewCount()"></app-star-rating>
      <ion-button fill="outline" size="small" (click)="toggleWishlist()">
        <ion-icon [name]="isWished() ? 'heart' : 'heart-outline'" slot="start"></ion-icon>
        {{ isWished() ? 'Wishlisted' : 'Wishlist' }}
      </ion-button>
      <p class="detail-description">{{ product()!.description }}</p>

      <h2 class="section-title">Choose Your Size</h2>
      <div class="size-grid">
        @for (opt of sizeOptions; track opt.key) {
          <button
            class="size-tile"
            [class.selected]="selectedSize() === opt.key"
            [class.out-of-stock]="product()!.stock[opt.key] === 0"
            (click)="selectSize(opt.key)"
            [attr.aria-pressed]="selectedSize() === opt.key"
          >
            <span class="tile-size">{{ opt.label }}</span>
            <span class="tile-price">{{ product()!.pricing[opt.key] | peso }}</span>
            <span class="tile-stock"
              [class.stock-in-stock]="product()!.stock[opt.key] >= lowStockThreshold"
              [class.stock-low-stock]="product()!.stock[opt.key] > 0 && product()!.stock[opt.key] < lowStockThreshold"
              [class.stock-out-of-stock]="product()!.stock[opt.key] === 0">
              {{ product()!.stock[opt.key] === 0 ? 'Out of Stock' :
                 product()!.stock[opt.key] < lowStockThreshold ? 'Low Stock (' + product()!.stock[opt.key] + ')' : 'In Stock' }}
            </span>
          </button>
        }
      </div>

      <div class="qty-row">
        <span class="qty-label">Quantity</span>
        <div class="qty-controls">
          <button class="qty-btn" (click)="decrementQty()" [disabled]="quantity() <= 1">
            <ion-icon name="remove-outline"></ion-icon>
          </button>
          <span class="qty-value">{{ quantity() }}</span>
          <button class="qty-btn" (click)="incrementQty()" [disabled]="quantity() >= currentStock()">
            <ion-icon name="add-outline"></ion-icon>
          </button>
        </div>
        <span class="line-total">{{ lineTotal() | peso }}</span>
      </div>

      <ion-button
        expand="block"
        class="add-to-cart-cta"
        [disabled]="isOutOfStock() || isAdding()"
        (click)="addToCart()"
      >
        <ion-icon name="cart-outline" slot="start"></ion-icon>
        {{ isAdding() ? 'Adding...' : isOutOfStock() ? 'Out of Stock' : 'Add to Cart' }}
      </ion-button>

      <div class="reviews-section">
        <h2 class="section-title">Customer Reviews</h2>
        @if (reviews().length === 0) {
          <div class="reviews-empty">
            <app-star-rating [rating]="0" [showCount]="true" [reviewCount]="0"></app-star-rating>
            <p class="no-reviews">No reviews yet — be the first!</p>
          </div>
        } @else {
          @for (r of reviews(); track r.id) {
            <div class="review-item">
              <app-star-rating [rating]="r.rating"></app-star-rating>
              <p class="review-author">{{ r.displayName }}</p>
              <p class="review-comment">{{ r.comment }}</p>
            </div>
          }
        }
        <div class="review-form">
          <h3 class="section-title">Write a review</h3>
          <app-star-rating [rating]="newRating()" [interactive]="true" (ratingChange)="newRating.set($event)"></app-star-rating>
          <ion-textarea [(ngModel)]="newComment" placeholder="What did you love?" rows="2"></ion-textarea>
          <ion-button expand="block" (click)="submitReview()" [disabled]="isSubmittingReview()">
            {{ isSubmittingReview() ? 'Submitting...' : 'Submit Review' }}
          </ion-button>
        </div>
      </div>
    </div>
  }

</ion-content>
</file>

<file path="src/app/features/products/products.page.html">
