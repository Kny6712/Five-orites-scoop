<!-- Five-orites Scoop — About Page -->

<ion-header>
  <ion-toolbar color="primary">
    <ion-buttons slot="start">
      <ion-menu-button aria-label="Open navigation menu"></ion-menu-button>
    </ion-buttons>
    <ion-title>About</ion-title>
  </ion-toolbar>
</ion-header>

<ion-content fullscreen>

  <!-- Hero Section -->
  <div class="about-hero">
    <div class="hero-logo-wrap">
      <img src="" alt="Five-orites Scoop logo — ice cream bowl with three colorful scoops" class="hero-logo" />
    </div>
    <h1 class="hero-title">Five-orites Scoop</h1>
    <p class="hero-tagline">"Premium ice cream, scooped to your door"</p>
    <ion-button [routerLink]="'/products'" class="hero-cta" size="default">
      Explore Flavors
      <ion-icon name="ice-cream-outline" slot="end"></ion-icon>
    </ion-button>
  </div>

  <div class="about-body">

    <!-- Vision Statement -->
    <section class="vision-section">
      <h2 class="section-heading">Our Vision</h2>
      <p class="vision-text">
        Five-orites Scoop was built to make premium ice cream effortlessly accessible.
        We believe your favourite scoop should find you — wherever you are — with real-time
        inventory transparency and zero guesswork. From browse to doorstep, every step is
        live, reliable, and delicious.
      </p>
