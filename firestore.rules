rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin = users/{uid}.role == 'admin'.
    // Bootstrap the first admin manually in the Firebase console,
    // then that admin can promote others.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Products ──────────────────────────────────────────────
    // Read: any signed-in user. Write: admin only, with basic validation.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.setNumber is int
        && request.resource.data.setNumber >= 1
        && request.resource.data.pricing.cup is int
        && request.resource.data.pricing.pint is int
        && request.resource.data.pricing.halfGallon is int
        && request.resource.data.pricing.gallon is int
        && request.resource.data.stock.cup is int
        && request.resource.data.stock.pint is int
        && request.resource.data.stock.halfGallon is int
        && request.resource.data.stock.gallon is int
        && request.resource.data.stock.cup >= 0
        && request.resource.data.stock.pint >= 0
        && request.resource.data.stock.halfGallon >= 0
        && request.resource.data.stock.gallon >= 0
        && request.resource.data.isActive is bool;
      allow delete: if false;
    }

    // ── Orders ────────────────────────────────────────────────
    match /orders/{orderId} {
      // Owner or admin can read (covers get + where(customerId == uid) lists).
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      // Owner creates their own pending order only.
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.items.size() > 0
        && request.resource.data.totalAmount >= 0
        && request.resource.data.grandTotal >= 0
        && request.resource.data.deliveryAddress is string
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'pending'
        // A discount can never exceed the subtotal it discounts.
        && request.resource.data.discountAmount is number
        && request.resource.data.discountAmount >= 0
        && request.resource.data.discountAmount <= request.resource.data.totalAmount;
      // Only admin advances status / edits. Customers cannot update.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Users ─────────────────────────────────────────────────
    match /users/{uid} {
      // Owner or admin can read.
      allow read: if isOwner(uid) || isAdmin();
      // Owner can create only their own doc, always as customer.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer';
      // Owner can edit profile but never change role.
      // Admin can edit anything (promotion path).
      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid);
      allow delete: if false;
    }

    // ── Reviews ───────────────────────────────────────────────
    // Any signed-in user can read; signed-in users can post their own review.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ── Vouchers ──────────────────────────────────────────────
    // Readable by customers for validation; writable by admin only.
    match /vouchers/{voucherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
